# ==============================================================================
# I-17 Program Dashboard — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file to version control.
# ==============================================================================

# --- Database ---
POSTGRES_DB=i17dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/i17dashboard

# Optional SQLite fallback for local-only use (no Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./i17dashboard.db

# --- Authentication ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Application ---
DEV_MODE=true
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://localhost:9200"]

# --- Data Directory ---
# Path to the local directory containing spreadsheet data files.
# Dana: set this to the folder where your recertification spreadsheets live.
# Example: DATA_DIR=/Users/dana/Documents/I17Data
DATA_DIR=
